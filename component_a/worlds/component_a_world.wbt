# ---- Goal marker (visual only, not a solid obstacle) ----
DEF GOAL_MARKER Solid {
  translation 3.5 3.5 0.01
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.0 1.0 0.0
        roughness 1.0
        metalness 0
        transparency 0.5
      }
      geometry Cylinder { radius 0.15 height 0.02 }
    }
  ]
  name "goal_marker"
}

# ---- Autonomous Robot (differential drive) ----
DEF AutonomousRobot Robot {
  translation -3.5 -3.5 0.033
  rotation 0 0 1 0.785398
  name "AutonomousRobot"
  controller "autonomous_controller"
  controllerArgs []
  children [
    # Robot body
    DEF BODY Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.1 0.7
        roughness 0.4
        metalness 0.1
      }
      geometry Cylinder { radius 0.07 height 0.05 }
    }

    # Left wheel
    DEF LEFT_WHEEL HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.052 0 0
      }
      device [
        RotationalMotor {
          name "left_wheel_motor"
          maxVelocity 6.28
        }
        PositionSensor {
          name "left_wheel_encoder"
        }
      ]
      endPoint Solid {
        translation -0.052 0 0
        rotation 0 1 0 0
        children [
          DEF WHEEL_SHAPE Shape {
            appearance PBRAppearance {
              baseColor 0.2 0.2 0.2
              roughness 0.8
              metalness 0
            }
            geometry Cylinder { radius 0.033 height 0.018 }
          }
        ]
        boundingObject USE WHEEL_SHAPE
        physics Physics { density 500 }
      }
    }

    # Right wheel
    DEF RIGHT_WHEEL HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.052 0 0
      }
      device [
        RotationalMotor {
          name "right_wheel_motor"
          maxVelocity 6.28
        }
        PositionSensor {
          name "right_wheel_encoder"
        }
      ]
      endPoint Solid {
        translation 0.052 0 0
        rotation 0 1 0 0
        children [
          USE WHEEL_SHAPE
        ]
        boundingObject USE WHEEL_SHAPE
        physics Physics { density 500 }
      }
    }

    # LiDAR sensor
    DEF LIDAR Lidar {
      translation 0 0 0.04
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.28318
      numberOfLayers 1
      minRange 0.05
      maxRange 3.5
      noise 0.02
    }

    # Camera
    DEF CAMERA Camera {
      translation 0.07 0 0.02
      rotation 0 0 1 0
      name "camera"
      width 64
      height 48
      fieldOfView 1.0472
    }

    # GPS for ground-truth position (evaluation only)
    DEF GPS GPS {
      name "gps"
    }

    # Compass for ground-truth heading (evaluation only)
    DEF COMPASS Compass {
      name "compass"
    }
  ]
  boundingObject Cylinder { radius 0.07 height 0.05 }
  physics Physics { density 200 }
}
